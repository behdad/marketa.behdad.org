RewriteEngine On
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^(.*)$ https://marketa.behdad.org/$1 [R=301,L]

<Files "CLAUDE.md">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<Files "BUILD.md">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

RewriteRule ^tests/ - [F,L]

# HTML must revalidate on every load — the site deploys continuously and a
# heuristically-cached rsvp.html serves fixes minutes late
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# WebAssembly.compileStreaming refuses anything but application/wasm — without
# this the self-hosted Pyodide/v86 runtimes fail to instantiate (.mjs typed for
# strict module imports for the same reason)
AddType application/wasm .wasm
AddType text/javascript .mjs

# PWA install (Add to Home screen): Chrome wants the manifest served as
# application/manifest+json. It's lenient about the type, but serve it right.
AddType application/manifest+json .webmanifest

# ── launch hardening: compression + caching ────────────────────────────────
# rsvp.html is ~1.6 MB uncompressed; gzip takes it to a few hundred KB. Every
# visitor benefits, and it slashes origin egress under a traffic spike.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript text/javascript application/json image/svg+xml \
    application/wasm application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  # The pinned runtimes never change (versioned by content) — cache them hard.
  # A new build ships under a new path, so "immutable" is safe.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(pyodide|linux|harfbuzzjs)/" LOFT_IMMUTABLE
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LOFT_IMMUTABLE

  # Media + fonts change rarely: a month of edge/browser cache absorbs a spike
  # while still letting an art tweak propagate within weeks.
  <FilesMatch "\.(mp4|webm|opus|mp3|wav|m4a|jpg|jpeg|png|webp|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
