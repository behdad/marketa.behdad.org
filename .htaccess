RewriteEngine On
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^(.*)$ https://marketa.behdad.org/$1 [R=301,L]

# The drops hub owns /; every published drop keeps its stable named URL.
DirectoryIndex index.html save-the-dates.html

# All .md files are internal docs (AGENTS.md, docs/, BUILD.md, DEBUGGING.md, SAFARI_BUGS.md,
# the pyodide/ + linux/ provenance READMEs, and anything added later) — none are meant to be
# public, so block the whole extension rather than enumerating each one.
<FilesMatch "\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Worker source/config are deployed by Wrangler, never served by Apache. In particular,
# do not let a missing Cloudflare route turn chat.js into a successful text response.
<FilesMatch "^(chat\.js|wrangler\.jsonc|\.dev\.vars(?:\..*)?|\.env(?:\..*)?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Deploy tooling for the untracked princejs/ runtime — internal, like the BUILD recipes.
<FilesMatch "^(fetch-princejs\.sh|princejs-shim\.patch)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RewriteRule ^tests/ - [F,L]

# Clean extensionless URLs (/rsvp, /save-the-dates, /loft-day) are plain symlinks to the
# .html files — the .htaccess rewrite trick doesn't work on this host (its -f file test
# can't resolve the real serving path). Add a symlink per new drop: ln -s foo.html foo
#
# Apache does not inherit the target's MIME type through these extensionless symlinks.
# Without an explicit type, mod_deflate's text/html rule below never sees them and the
# large game entry point is sent uncompressed. Keep the aliases dynamic/revalidated,
# but give them the same type, compression, and cache policy as their .html targets.
<FilesMatch "^[^.]+$">
  ForceType text/html
  <IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# HTML must revalidate on every load — the site deploys continuously and a
# heuristically-cached loft-day.html serves fixes minutes late. The PWA manifest too:
# a stale cached manifest kept installing the old start_url (opened the full page,
# not the game), and reinstalling reused the cache — so never let it cache heuristically.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# WebAssembly.compileStreaming refuses anything but application/wasm — without
# this the self-hosted Pyodide/v86 runtimes fail to instantiate (.mjs typed for
# strict module imports for the same reason)
AddType application/wasm .wasm
AddType text/javascript .mjs

# PWA install (Add to Home screen): Chrome wants the manifest served as
# application/manifest+json. It's lenient about the type, but serve it right.
AddType application/manifest+json .webmanifest

# ── launch hardening: compression + caching ────────────────────────────────
# Text and self-hosted runtime assets benefit from transparent compression,
# reducing origin egress without changing the files visitors receive.
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript text/javascript application/json image/svg+xml \
    application/wasm application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript text/javascript application/json image/svg+xml \
    application/wasm application/manifest+json
  # Large self-hosted binaries served as octet-stream (so the type filter above misses them):
  # These large binaries are fetched WHOLE (Emscripten createPreloadedFile / v86's non-async
  # cdrom), so the browser's transparent
  # gunzip hands the runtime the full bytes — safe. (.wasm is already covered above; .zip/.whl are
  # already-compressed, so they're left alone.)
  <FilesMatch "\.(wad|iso)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # The pinned runtimes never change (versioned by content) — cache them hard.
  # A new build ships under a new path, so "immutable" is safe.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(pyodide|linux|harfbuzzjs|doom|duke|q3|princejs)/" LOFT_IMMUTABLE
    # Code's public built-ins are live source, not versioned bundles. Revalidate them with the
    # page so the IDE never pairs a new manifest with stale sample text.
    SetEnvIf Request_URI "^/code-snippets/" LOFT_CODE_SNIPPET
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LOFT_IMMUTABLE
  Header set Cache-Control "no-cache" env=LOFT_CODE_SNIPPET

  # Media + fonts change rarely: a month of edge/browser cache absorbs a spike
  # while still letting an art tweak propagate within weeks.
  <FilesMatch "\.(mp4|webm|opus|mp3|wav|m4a|jpg|jpeg|png|webp|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
