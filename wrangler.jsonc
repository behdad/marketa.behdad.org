{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketa-loft-chat",
  "main": "chat.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "marketa.behdad.org/chat*",
      "zone_name": "behdad.org"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "TURNSTILE_SECRET"]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "20270501",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
